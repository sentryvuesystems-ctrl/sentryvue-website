generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model ContactSubmission {
  id                String   @id @default(cuid())
  fullName          String
  email             String
  phone             String
  postcode          String
  propertyType      String
  cameraCount       String
  installationDate  String?
  notes             String?
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model Order {
  id              String   @id @default(cuid())
  reference       String   @unique
  status          String   @default("pending")
  placement       String
  cameraCount     Int
  indoorCount     Int
  outdoorCount    Int
  resolution      String
  kitName         String
  storageTb       Int
  kitPence        Int
  storagePence    Int
  discountPence   Int
  subtotalPence   Int
  deliveryPence   Int?
  totalPence      Int
  launchOffer     Boolean  @default(false)
  paymentMethod   String
  stripeSessionId String?
  fullName        String
  email           String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  county          String?
  postcode        String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}
